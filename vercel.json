{
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/files.js": {
      "includeFiles": "**/*"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/files/:path*",
      "destination": "/api/files"
    },
    {
      "source": "/files",
      "destination": "/api/files"
    }
  ]
}